rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Default safety deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Factory Production Jobs
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Paper Reel & Converting Inventory Lots
    match /inventory/{inventoryId} {
      allow read, write: if true;
    }

    // Factory Config & Dropdowns (Job Types, Stock Types, Presses, Suppliers)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Office Daybook Accounts & Ledger Entries
    match /accounts/{accountId} {
      allow read, write: if true;
    }
    match /entries/{entryId} {
      allow read, write: if true;
    }
    match /deletedEntries/{entryId} {
      allow read, write: if true;
    }
    match /editedEntries/{entryId} {
      allow read, write: if true;
    }
  }
}
